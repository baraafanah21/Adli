# Copy to .env.local for local dev. Same keys go into Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://hdkmrozwihaoqiqjlzld.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# International format, digits only, no + (e.g. 970599123456)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Server only (never NEXT_PUBLIC_). Generate with: openssl rand -hex 32. Its sha256 goes in private.app_secrets.
ORDER_GATEWAY_SECRET=
# "true" only once customers can receive auth email (verified sending domain in Resend). Until then the site hides the
# sign-in link and «نسيت كلمة المرور» (WhatsApp instead). Checklist: CLAUDE.md, «Email».
NEXT_PUBLIC_EMAIL_ENABLED=false
# Local only, never on Vercel: an owner account for scripts/storage-orphans.mjs (npm run storage:orphans).
STORAGE_SCRIPT_EMAIL=
STORAGE_SCRIPT_PASSWORD=
