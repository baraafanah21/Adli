# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# Phase U screenshots (local only)
/docs/screens/

# Salon photos and videos (raw and compressed), never in git
/salon-media/

# Issue / PR bodies written before each gh command
/.github/tmp/

# Claude Code: local permissions stay local; skills are tracked
/.claude/settings.json
/.claude/settings.local.json
!/.claude/skills/
